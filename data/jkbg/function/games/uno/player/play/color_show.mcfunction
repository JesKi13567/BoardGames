# 颜色方块
execute as @s[scores={jkbg.uno.color=0}] run function jkbg:games/uno/player/play/color_show_ {color:white}
execute as @s[scores={jkbg.uno.color=1}] run function jkbg:games/uno/player/play/color_show_ {color:red}
execute as @s[scores={jkbg.uno.color=2}] run function jkbg:games/uno/player/play/color_show_ {color:blue}
execute as @s[scores={jkbg.uno.color=3}] run function jkbg:games/uno/player/play/color_show_ {color:green}
execute as @s[scores={jkbg.uno.color=4}] run function jkbg:games/uno/player/play/color_show_ {color:yellow}
