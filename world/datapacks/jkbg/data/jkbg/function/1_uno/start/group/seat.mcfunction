# ============================================================
# 座位宏：一名玩家 = 一个桌位（抓牌/变色/质疑按钮 + 上下两排手牌各 20 格）
# 调用：execute as @p[...] positioned 4.0 100.0 -11.0 rotated 0 0 run function jkbg:1_uno/start/group/seat {yaw: 0, brot: 0, mem: 1}
# 说明：生成用的坐标系由调用方的 positioned / rotated 决定（不再依赖 tp 是否生效），
#       所以函数内一律用 ^ 局部坐标（左/上/前）；yaw 只用于实体 Rotation 和玩家朝向，必须与 rotated 的 yaw 一致
# 参数：yaw 朝向 · brot「抓牌」牌背 yaw（东西向座位为 90）· mem 玩家 id
# ============================================================
$tp @s ~ ~ ~ $(yaw) 0

# 抓牌
summon interaction ^0.5 ^0.1 ^2.5 {Tags: ["jkbg", "jkbg_uno_number", "draw"], response: true, height: 0.1, width: 0.6}
$summon item_display ^0.5 ^0.1 ^2.5 {Tags: ["jkbg", "jkbg_uno_number", "draw"], brightness: {block: 15, sky: 15}, item: {id: "paper", components: {item_model: "jkbg:uno/500"}}, transformation: {left_rotation: [0, 0, 0, 1], right_rotation: [0, 0, 0, 1], scale: [.5, .5, .5], translation: [-.125, .25, -.06]}, CustomName: {translate: "jkbg.uno.module.draw", color: "yellow"}, CustomNameVisible: true, Rotation: [$(brot), 0]}

# 变色
$summon interaction ^-0.5 ^0.1 ^2.5 {Tags: ["jkbg", "jkbg_uno_number", "$(mem)", "wild"], response: true, height: 0.1, width: 0.6}
$summon item_display ^-0.5 ^0.1 ^2.5 {Tags: ["jkbg", "jkbg_uno_number", "$(mem)", "wild"], brightness: {block: 15, sky: 15}, item: {id: "white_wool"}, transformation: {left_rotation: [0, 0, 0, 1], right_rotation: [0, 0, 0, 1], scale: [.3, .3, .3], translation: [0, 0, 0]}, CustomName: {translate: "jkbg.uno.module.wild"}, CustomNameVisible: true}

# 质疑
execute if score #uno.rule.challenge jkbg.int matches 1 run summon interaction ^ ^0.1 ^1.5 {Tags: ["jkbg", "jkbg_uno_number", "challenge"], response: true, height: 0.1, width: 0.6}
execute if score #uno.rule.challenge jkbg.int matches 1 run summon item_display ^ ^0.2 ^1.5 {Tags: ["jkbg", "jkbg_uno_number", "challenge"], brightness: {block: 15, sky: 15}, item: {id: "ender_eye"}, transformation: {left_rotation: [0, 0, 0, 1], right_rotation: [0, 0, 0, 1], scale: [.3, .3, .3], translation: [0, 0, 0]}, CustomName: {translate: "jkbg.uno.module.challenge.name", color: "yellow"}, CustomNameVisible: true, Rotation: [0, 90]}

